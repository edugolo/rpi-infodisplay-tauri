FROM ghcr.io/cross-rs/aarch64-unknown-linux-gnu:edge

RUN dpkg --add-architecture arm64

# Add Debian bookworm repos for libwebkit2gtk-4.1
RUN sed -i 's|focal|bookworm|g' /etc/apt/sources.list 2>/dev/null || true && \
    echo "deb [arch=amd64,arm64] http://deb.debian.org/debian bookworm main" > /etc/apt/sources.list.d/debian.list && \
    echo "deb [arch=amd64,arm64] http://deb.debian.org/debian bookworm-updates main" >> /etc/apt/sources.list.d/debian.list

RUN apt-get update && apt-get install -y \
    libwebkit2gtk-4.1-dev:arm64 \
    libgtk-3-dev:arm64 \
    libayatana-appindicator3-dev:arm64 \
    librsvg2-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig
