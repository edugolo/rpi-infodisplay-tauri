[Unit]
Description=Edugo Kiosk Display (Tauri)
After=seatd.service network-online.target
Wants=seatd.service network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rpi-infodisplay
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/cage -d -- /opt/rpi-infodisplay/rpi-infodisplay
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kiosk-display

# On shutdown, stop the service cleanly. The app's scheduler also
# self-invokes "systemctl stop" at the scheduled off-time (see display.rs).
# CEC Standby is sent by the app before stopping when available.
ExecStop=/usr/bin/journalctl --flush

[Install]
WantedBy=multi-user.target
